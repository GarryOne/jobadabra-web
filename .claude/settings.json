{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/jobadabra/tools/pr-red-check.sh",
            "timeout": 10,
            "statusMessage": "Checking that your pull request is not red…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/jobadabra/tools/pr-red-check.sh",
            "timeout": 10,
            "statusMessage": "Checking that your pull request is not red…"
          }
        ]
      }
    ]
  }
}
