{
  // Transfer step 1 (transfer/README.md): the NEW Worker declares it expects the namespace and the container, with no binding yet.
  // The deploy ends with "Could not deploy container configuration as durable object was not found in the account namespace list": expected, the pending transfer is already recorded (proven 1 Nov 2026).
  "name": "jobadabra-ai-broker",
  "main": "../worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {"AUDIENCE": "jobadabra-ai-broker,jobadabra-codex-broker", "REPOSITORY": "GarryOne/jobadabra,GarryOne/jobadabra-web,GarryOne/jobadabra-lab,jobadabra/jobadabra,jobadabra/jobadabra-web,jobadabra/jobadabra-lab", "FALLBACK_FREE_AI_DAY_USD": "2"},
  "containers": [
    {"name": "ai-broker", "image": "../container/Dockerfile", "image_build_context": "..", "instance_type": "basic", "max_instances": 1}
  ],
  "ai": {"binding": "AI"},
  "exports": {"CodexBroker": {"type": "durable-object", "state": "expecting-transfer", "storage": "sqlite", "transfer_from": "jobadabra-codex-broker", "container": "ai-broker"}}
}
