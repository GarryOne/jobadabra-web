{
  // Transfer step 2: the OLD Worker commits the transfer and becomes the forwarder (alias.js). No container, no Durable Object binding (a tombstone refuses both).
  // Its migrations history is replaced by `exports` in this one deploy (proven 1 Nov 2026).
  "name": "jobadabra-codex-broker",
  "main": "alias.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {"enabled": true},
  "services": [{"binding": "AI_BROKER", "service": "jobadabra-ai-broker"}],
  "exports": {"CodexBroker": {"type": "durable-object", "state": "transferred", "transferred_to": "jobadabra-ai-broker"}}
}
