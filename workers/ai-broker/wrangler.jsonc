{
  // The AI broker (see worker.js). basic (1 GiB): one `codex exec` at a time uses well under 1 GiB (measured 28 Oct 2026, throwaway check: codex 0.162.1 runs as uid 1001). max_instances 1 = ONE login, ONE refresher.
  // Secret: BROKER_ADMIN_TOKEN (wrangler secret put; Keychain job-pilotto.codex-broker.admin_token), only for the owner's one-time login upload.
  // Why (1 Nov 2026, owner: rename to ai-broker): this is the FINAL state after the Durable Object namespace moved here from the Worker `jobadabra-codex-broker` (which stays as a forwarder). Never deploy it before the transfer
  // has run (transfer/README.md): a plain deploy of a new Worker name starts an EMPTY namespace and the Codex login is gone (seen on the throwaway proof, 1 Nov 2026). release-ai-broker.yml refuses unless /health says ready.
  "name": "jobadabra-ai-broker",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {"enabled": true},
  // Why (31 Oct 2026, owner: '$2/day'): Free AI has its own UTC-day cap, separate from Claude's $5/day.
  "vars": {"AUDIENCE": "jobadabra-ai-broker,jobadabra-codex-broker", "REPOSITORY": "GarryOne/jobadabra,GarryOne/jobadabra-web,GarryOne/jobadabra-lab,jobadabra/jobadabra,jobadabra/jobadabra-web,jobadabra/jobadabra-lab", "FALLBACK_FREE_AI_DAY_USD": "2", "ENGINE": "codex"},
  // Container application name `ai-broker` (not derived from the class), so the later class rename does not create a new application (proven 1 Nov 2026).
  "containers": [
    {"name": "ai-broker", "image": "./container/Dockerfile", "image_build_context": ".", "instance_type": "basic", "max_instances": 1}
  ],
  // Owner sets ANTHROPIC_API_KEY, BRAIN_BOT_TOKEN and BRAIN_CHAT_ID as Worker secrets (they must be set on this Worker too: secrets do not move with the namespace).
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings": [{"name": "BROKER", "class_name": "CodexBroker"}]},
  "exports": {"CodexBroker": {"type": "durable-object", "storage": "sqlite", "container": "ai-broker"}}
}
