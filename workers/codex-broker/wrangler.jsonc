{
  // The Codex broker (see worker.js). basic (1 GiB): one `codex exec` at a time uses well under 1 GiB (measured 28 Oct 2026, throwaway check: codex 0.162.1 runs as uid 1001). max_instances 1 = ONE login, ONE refresher.
  // Secret: BROKER_ADMIN_TOKEN (wrangler secret put; Keychain job-pilotto.codex-broker.admin_token), only for the owner's one-time login upload.
  "name": "jobadabra-codex-broker",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {"enabled": true},
  // Why (31 Oct 2026, owner: '$2/day'): Free AI has its own UTC-day cap, separate from Claude's $5/day.
  "vars": {"AUDIENCE": "jobadabra-codex-broker", "REPOSITORY": "GarryOne/jobadabra,GarryOne/jobadabra-web", "FALLBACK_FREE_AI_DAY_USD": "2"},
  "containers": [
    {"class_name": "CodexBroker", "image": "./container/Dockerfile", "image_build_context": ".", "instance_type": "basic", "max_instances": 1}
  ],
  // Owner sets ANTHROPIC_API_KEY, BRAIN_BOT_TOKEN and BRAIN_CHAT_ID as Worker secrets.
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings": [{"name": "BROKER", "class_name": "CodexBroker"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CodexBroker"]}]
}
